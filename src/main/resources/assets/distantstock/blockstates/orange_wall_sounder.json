{
  "multipart": [
    {
      "when": {
        "lit": "false",
        "facing": "north"
      },
      "apply": {
        "model": "distantstock:block/sounder/orange_off"
      }
    },
    {
      "when": {
        "lit": "false",
        "facing": "east"
      },
      "apply": {
        "model": "distantstock:block/sounder/orange_off",
        "y": 90
      }
    },
    {
      "when": {
        "lit": "false",
        "facing": "south"
      },
      "apply": {
        "model": "distantstock:block/sounder/orange_off",
        "y": 180
      }
    },
    {
      "when": {
        "lit": "false",
        "facing": "west"
      },
      "apply": {
        "model": "distantstock:block/sounder/orange_off",
        "y": 270
      }
    },
    {
      "when": {
        "lit": "true",
        "facing": "north"
      },
      "apply": {
        "model": "distantstock:block/sounder/orange_on"
      }
    },
    {
      "when": {
        "lit": "true",
        "facing": "east"
      },
      "apply": {
        "model": "distantstock:block/sounder/orange_on",
        "y": 90
      }
    },
    {
      "when": {
        "lit": "true",
        "facing": "south"
      },
      "apply": {
        "model": "distantstock:block/sounder/orange_on",
        "y": 180
      }
    },
    {
      "when": {
        "lit": "true",
        "facing": "west"
      },
      "apply": {
        "model": "distantstock:block/sounder/orange_on",
        "y": 270
      }
    }
  ]
}
